<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Handicrafts TZ</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f9f9f9;
      margin: 0;
      padding: 0;
    }
    header {
      background: #2c3e50;
      padding: 10px 20px;
      color: white;
      text-align: center;
    }
    nav {
      text-align: center;
      background: #3498db;
      padding: 10px;
    }
    nav a {
      color: white;
      margin: 0 15px;
      text-decoration: none;
    }
    .carousel {
      max-width: 100%;
      margin: 20px auto;
      overflow: hidden;
    }
    #form-section {
      margin: 30px;
      padding: 20px;
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .form-group {
      margin: 15px 0;
    }
    label {
      display: block;
      margin-bottom: 5px;
    }
    input[type="text"], input[type="email"], input[type="password"], select {
      width: 100%;
      padding: 10px;
      margin: 5px 0;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    .error {
      color: red;
      font-size: 0.9em;
    }
    button {
      background-color: #27ae60;
      color: white;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <header>
    <h1>Handicrafts TZ</h1>
    <p>Explore the beauty of Tanzanian handicrafts</p>
  </header>
  
  <nav>
    <a href="#">Home</a>
    <a href="#products">Products</a>
    <a href="#artists">Artists</a>
    <a href="#blog">Blog</a>
    <a href="#contact">Contact Us</a>
  </nav>

  <section id="form-section">
    <h2>User Registration Form</h2>
    <form id="registration-form">
      <div class="form-group">
        <label for="full-name">Full Name</label>
        <input type="text" id="full-name" name="full-name" required>
        <span class="error" id="name-error"></span>
      </div>

      <div class="form-group">
        <label for="reg-number">Registration Number (Format: BCS-00-0000-0000)</label>
        <input type="text" id="reg-number" name="reg-number" required>
        <span class="error" id="reg-error"></span>
      </div>

      <div class="form-group">
        <label for="sex">Sex</label>
        <select id="sex" name="sex">
          <option value="">Select...</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
        <span class="error" id="email-error"></span>
      </div>

      <div class="form-group">
        <label for="region">Region</label>
        <select id="region" name="region">
          <option value="">Select...</option>
          <option value="Dar es Salaam">Dar es Salaam</option>
          <option value="Arusha">Arusha</option>
        </select>
      </div>

      <div class="form-group">
        <label for="district">District</label>
        <select id="district" name="district">
          <option value="">Select a region first...</option>
        </select>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
        <span class="error" id="password-error"></span>
      </div>

      <div class="form-group">
        <label for="confirm-password">Confirm Password</label>
        <input type="password" id="confirm-password" name="confirm-password" required>
      </div>

      <button type="submit">Register</button>
    </form>
  </section>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
  <script>
    $(document).ready(function () {
      // Dynamic district loading
      $('#region').on('change', function () {
        const region = $(this).val();
        const districtOptions = {
          'Dar es Salaam': ['Ilala', 'Temeke', 'Kinondoni'],
          'Arusha': ['Arumeru', 'Karatu', 'Monduli']
        };
        $('#district').empty().append('<option value="">Select...</option>');
        if (districtOptions[region]) {
          districtOptions[region].forEach(function (district) {
            $('#district').append(`<option value="${district}">${district}</option>`);
          });
        }
      });

      // Form validation
      $('#registration-form').on('submit', function (e) {
        e.preventDefault();
        let valid = true;

        // Name validation
        const name = $('#full-name').val();
        if (!/^[a-zA-Z\s]+$/.test(name)) {
          valid = false;
          $('#name-error').text('Please enter a valid full name.');
        } else {
          $('#name-error').text('');
        }

        // Registration number validation
        const regNumber = $('#reg-number').val();
        if (!/^BCS-\d{2}-\d{4}-\d{4}$/.test(regNumber)) {
          valid = false;
          $('#reg-error').text('Registration number must follow the format BCS-00-0000-0000.');
        } else {
          $('#reg-error').text('');
        }

        // Email validation
        const email = $('#email').val();
        if (!/^[\w.%+-]+@[\w.-]+\.[a-zA-Z]{2,}$/.test(email)) {
          valid = false;
          $('#email-error').text('Please enter a valid email address.');
        } else {
          $('#email-error').text('');
        }

        // Password validation
        const password = $('#password').val();
        const confirmPassword = $('#confirm-password').val();
        if (password.length < 8 || !/[!@#$%^&*]/.test(password)) {
          valid = false;
          $('#password-error').text('Password must be at least 8 characters long and contain a special character.');
        } else {
          $('#password-error').text('');
        }

        if (password !== confirmPassword) {
          valid = false;
          alert('Passwords do not match.');
        }

        if (valid) {
          alert('Registration successful!');
          this.submit();
        }
      });
    });
  </script>
</body>
</html>
